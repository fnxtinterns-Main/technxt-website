# ===================================================================
# TECHNXTAI CLEAN URL ROUTING (HOSTINGER & APACHE COMPATIBLE)
# ===================================================================
RewriteEngine On
RewriteBase /

# 1. 301 Redirect /about or /about/ to root /
RewriteRule ^about/?$ / [R=301,L]

# 2. 301 Redirect: Strip .html extension from browser address bar
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. 301 Redirect: Remove trailing slash from URLs (e.g. /services/ -> /services)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ /%1 [R=301,L]

# 4. Internally serve file.html for clean URL (e.g. /services -> services.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# 5. Cache-Control: ensure fresh JS/CSS on Hostinger
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
