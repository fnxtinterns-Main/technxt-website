# ===================================================================
# TECHNXTAI CLEAN URL ROUTING (HOSTINGER & APACHE COMPATIBLE)
# ===================================================================
RewriteEngine On
RewriteBase /

# 1. External 301 Redirect: Remove .html from browser address bar
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. If directory/index.html exists, serve it
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# 3. If file.html exists, internally serve file.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*?)/?$ $1.html [L]
